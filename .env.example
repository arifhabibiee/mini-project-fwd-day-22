# Local development configuration. Copy to .env and replace BOTH password placeholders.
# Never commit .env, share passwords, or run the backend with the setup/admin account.

PORT=3000
DB_HOST=127.0.0.1
DB_PORT=5434
DB_NAME=mw75_tumi

# Limited read-only application account (automatically created on first DB initialization).
DB_USER=mw75_reader
DB_PASSWORD=REPLACE_WITH_PRIVATE_RUNTIME_PASSWORD

# PostgreSQL initial setup/admin account (not used by the Node.js backend).
POSTGRES_USER=mw75_admin
POSTGRES_PASSWORD=REPLACE_WITH_PRIVATE_ADMIN_PASSWORD
