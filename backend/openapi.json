                "schema": {
                  "type": "string"
                },
                "example": "GET, HEAD, OPTIONS"
              }
            }
          },
          "500": {
            "description": "Invalid database product data or internal failure.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "examples": {
                  "invalidData": {
                    "value": {
                      "error": {
                        "code": "INVALID_PRODUCT_DATA",
                        "message": "Data produk tidak valid."
                      }
                    }
                  },
                  "internal": {
                    "value": {
                      "error": {
                        "code": "INTERNAL_ERROR",
                        "message": "Terjadi kesalahan internal."
                      }
                    }
                  }
                }
              }
            }
          },
          "503": {
            "description": "Connection/authentication/database failure or timeout; no private details.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error": {
                    "code": "DATABASE_UNAVAILABLE",
                    "message": "Database sementara tidak tersedia."
                  }
                }
              }
            }
          }
        }
