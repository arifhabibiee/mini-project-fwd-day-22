{
  "openapi": "3.0.3",
  "info": {
    "title": "MW75 TUMI Independent Product API",
    "version": "1.0.0",
    "description": "Read-only API for an independent product-detail application, not operated by or affiliated with Master & Dynamic or TUMI. Availability is demonstration configuration, not verified commercial inventory. Actual dataset-specific mapping/validation; no checkout, CRUD mutations, authentication, listing or slug lookup."
  },
  "servers": [
    {
      "url": "/",
      "description": "Same origin as Swagger UI; no private configuration."
    }
  ],
  "tags": [
    {
      "name": "Health",
      "description": "Application/database read readiness."
    },
    {
      "name": "Products",
      "description": "Product, variants, gallery and editorial."
    }
  ],
  "paths": {
    "/api/health": {
      "get": {
        "tags": [
          "Health"
        ],
        "operationId": "getHealth",
        "summary": "Application/database readiness",
        "description": "Checks connectivity and SELECT access to all three product tables. Ready does not guarantee record count or validity of every product. No credentials, host, SQL or stack trace exposed.",
        "responses": {
          "200": {
            "description": "Application and database ready.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthSuccess"
                },
                "example": {
                  "data": {
                    "status": "ok",
                    "application": "ready",
                    "database": "ready"
                  }
                }
              }
            }
          },
          "403": {
            "description": "Origin outside the loopback development allowlist.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error": {
                    "code": "ORIGIN_NOT_ALLOWED",
                    "message": "Origin tidak diizinkan."
                  }
                }
              }
            }
          },
          "405": {
            "description": "Unsupported method for this resource.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error": {
                    "code": "METHOD_NOT_ALLOWED",
                    "message": "Method tidak diizinkan."
                  }
                }
              }
            },
            "headers": {
              "Allow": {
                "schema": {
                  "type": "string"
                },
                "example": "GET, HEAD, OPTIONS"
              }
            }
          },
          "503": {
            "description": "Database connection/query/table access failed.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthUnavailable"
                },
                "example": {
                  "data": {
                    "status": "degraded",
                    "application": "ready",
                    "database": "unavailable"
                  },
                  "error": {
                    "code": "DATABASE_UNAVAILABLE",
                    "message": "Database sementara tidak tersedia."
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/products/{id}": {
      "get": {
        "tags": [
          "Products"
        ],
        "operationId": "getProductById",
        "summary": "Product detail by generated ID",
        "description": "Parameterized SELECT in one snapshot with variants/images ordered by position. ID 1 is the current dataset example, not an API default. Canonical positive decimal only: no leading zero, signs, whitespace, fractions, scientific notation or overflow. Color/variant selection is frontend state, not an API query parameter. Unavailable/unknown variants still return 200. Server validates default references, uniqueness and stock/purchasable consistency. HEAD follows GET, OPTIONS supports preflight; Swagger Try it out uses GET only.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "Canonical decimal matching ^[1-9][0-9]*$, in positive PostgreSQL INTEGER range. 01 is invalid.",
            "schema": {
              "type": "integer",
              "format": "int32",
              "minimum": 1,
              "maximum": 2147483647
            },
            "example": 1
          }
        ],
        "responses": {
          "200": {
            "description": "Found product with validated variant, image and editorial payload.",
