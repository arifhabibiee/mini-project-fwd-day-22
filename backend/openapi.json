          "400": {
            "description": "Invalid ID or malformed URL encoding.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "examples": {
                  "invalidId": {
                    "value": {
                      "error": {
                        "code": "INVALID_PRODUCT_ID",
                        "message": "ID produk harus integer positif yang valid."
                      }
                    }
                  },
                  "invalidRequest": {
                    "value": {
