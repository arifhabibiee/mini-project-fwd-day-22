  },
  "components": {
    "schemas": {
      "ErrorResponse": {
        "type": "object",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "object",
            "required": [
              "code",
              "message"
            ],
            "properties": {
              "code": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "message": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              }
            }
          }
        }
      },
      "HealthSuccess": {
        "type": "object",
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "type": "object",
            "required": [
              "status",
              "application",
              "database"
            ],
            "properties": {
              "status": {
                "type": "string",
                "enum": [
                  "ok"
                ]
              },
              "application": {
                "type": "string",
                "enum": [
                  "ready"
                ]
              },
              "database": {
                "type": "string",
                "enum": [
                  "ready"
                ]
              }
            }
          }
        }
      },
      "HealthUnavailable": {
        "type": "object",
        "required": [
          "data",
          "error"
        ],
        "properties": {
          "data": {
            "type": "object",
            "required": [
              "status",
              "application",
              "database"
            ],
            "properties": {
              "status": {
                "type": "string",
                "enum": [
                  "degraded"
                ]
              },
              "application": {
                "type": "string",
                "enum": [
                  "ready"
                ]
              },
              "database": {
                "type": "string",
                "enum": [
                  "unavailable"
                ]
              }
            }
          },
          "error": {
            "type": "object",
            "required": [
              "code",
              "message"
            ],
            "properties": {
              "code": {
                "type": "string",
                "enum": [
                  "DATABASE_UNAVAILABLE"
                ]
              },
              "message": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              }
            }
          }
        }
      },
      "QuantityPolicy": {
        "type": "object",
        "required": [
          "min",
          "maxPerOrder"
        ],
        "properties": {
          "min": {
            "type": "integer",
            "enum": [
              1
            ]
          },
          "maxPerOrder": {
            "type": "integer",
            "format": "int32",
            "minimum": 1,
            "maximum": 2147483647,
            "nullable": true,
            "description": "null means no known business limit; not unlimited inventory."
          }
        }
      },
      "Media": {
        "type": "object",
        "required": [
          "url",
          "alt",
          "fallbackUrl"
        ],
        "properties": {
          "url": {
            "type": "string",
            "description": "Server permits HTTPS reference hosts without credentials/port or local /assets/<name>.svg.",
            "anyOf": [
              {
                "pattern": "^/assets/[a-zA-Z0-9_-]+\\.svg$"
              },
              {
                "format": "uri",
                "pattern": "^https://(www\\.masterdynamic\\.com|support\\.masterdynamic\\.com)/"
              }
            ]
          },
          "alt": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "fallbackUrl": {
            "type": "string",
            "description": "API media fallback or null; never a product fallback after API failure.",
            "anyOf": [
              {
                "pattern": "^/assets/[a-zA-Z0-9_-]+\\.svg$"
              },
              {
                "format": "uri",
                "pattern": "^https://(www\\.masterdynamic\\.com|support\\.masterdynamic\\.com)/"
              }
            ],
            "nullable": true
          }
        }
      },
      "Image": {
        "allOf": [
          {
            "$ref": "#/components/schemas/Media"
          },
          {
            "type": "object",
            "required": [
              "id",
              "position"
            ],
            "properties": {
              "id": {
                "type": "integer",
                "format": "int32",
                "minimum": 1,
                "maximum": 2147483647
              },
              "position": {
                "type": "integer",
                "format": "int32",
                "minimum": 0,
                "maximum": 2147483647,
                "description": "Nonnegative position, unique per variant; sorted ascending."
              }
            }
          }
        ]
      },
      "Link": {
        "type": "object",
        "required": [
          "label",
          "url"
        ],
        "properties": {
          "label": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "url": {
            "type": "string",
            "description": "Server permits HTTPS reference hosts without credentials/port or local /assets/<name>.svg.",
            "anyOf": [
              {
                "pattern": "^/assets/[a-zA-Z0-9_-]+\\.svg$"
              },
              {
                "format": "uri",
                "pattern": "^https://(www\\.masterdynamic\\.com|support\\.masterdynamic\\.com)/"
              }
            ]
          }
        }
      },
      "Feature": {
        "type": "object",
        "required": [
          "title",
          "text",
          "iconKey"
        ],
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "text": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "iconKey": {
            "type": "string",
            "enum": [
              "anc",
              "materials",
              "drivers",
              "battery",
              "bluetooth",
              "microphones"
            ]
          }
        }
      },
      "Benefit": {
        "type": "object",
        "required": [
          "title",
          "text"
        ],
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "text": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        }
      },
      "Protection": {
        "type": "object",
        "required": [
          "title",
          "note"
        ],
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "note": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        }
      },
      "Story": {
        "type": "object",
        "required": [
          "eyebrow",
          "title",
          "paragraphs",
          "media",
          "links"
        ],
        "properties": {
          "eyebrow": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "paragraphs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "minItems": 1
          },
          "media": {
            "$ref": "#/components/schemas/Media"
          },
          "links": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Link"
            }
          }
        }
      },
      "SpecRow": {
        "type": "object",
        "required": [
          "label",
          "value"
        ],
        "properties": {
          "label": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "value": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        }
      },
      "SpecGroup": {
        "type": "object",
        "required": [
          "title",
          "rows"
        ],
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "rows": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SpecRow"
            },
            "minItems": 1
          }
        }
      },
      "BoxItem": {
        "type": "object",
        "required": [
          "label",
          "media"
        ],
        "properties": {
          "label": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "media": {
            "$ref": "#/components/schemas/Media"
          }
        }
      },
      "Support": {
        "type": "object",
        "required": [
          "eyebrow",
          "title",
          "text",
          "media",
          "link"
        ],
        "properties": {
          "eyebrow": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "text": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "media": {
            "$ref": "#/components/schemas/Media"
          },
          "link": {
            "$ref": "#/components/schemas/Link"
          }
        }
      },
      "EditorialContent": {
        "type": "object",
        "required": [
          "eyebrow",
          "features",
          "benefits",
          "protection",
          "stories",
          "specGroups",
          "boxItems",
          "support"
        ],
        "properties": {
          "eyebrow": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "features": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Feature"
            },
            "minItems": 6,
            "maxItems": 6
          },
          "benefits": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Benefit"
            },
            "minItems": 3,
            "maxItems": 3
          },
          "protection": {
            "$ref": "#/components/schemas/Protection"
          },
          "stories": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Story"
            },
            "minItems": 2,
            "maxItems": 2
          },
          "specGroups": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SpecGroup"
            },
            "minItems": 3,
            "maxItems": 3
          },
          "boxItems": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/BoxItem"
            },
            "minItems": 7,
            "maxItems": 7
          },
          "support": {
            "$ref": "#/components/schemas/Support"
          }
        }
      },
      "Variant": {
        "type": "object",
        "required": [
          "id",
          "colorCode",
          "label",
          "referenceVariantId",
          "availability",
          "stockQuantity",
          "isDefault",
          "position",
          "purchasable",
          "images"
        ],
        "properties": {
          "id": {
            "type": "integer",
            "format": "int32",
            "minimum": 1,
            "maximum": 2147483647
          },
          "colorCode": {
            "type": "string",
            "enum": [
              "black",
              "silver"
            ]
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "referenceVariantId": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S",
            "nullable": true,
            "description": "Source reference ID if known; not internal variant ID."
          },
          "availability": {
            "type": "string",
            "enum": [
              "available",
              "unavailable",
              "unknown"
            ],
            "description": "Demonstration configuration, not real-time commercial stock."
          },
          "stockQuantity": {
            "type": "integer",
            "format": "int32",
            "minimum": 0,
            "maximum": 2147483647,
            "nullable": true,
            "description": "null means unknown; zero cannot be combined with available."
          },
          "isDefault": {
            "type": "boolean",
            "description": "Exactly one default variant; defaultVariantId references its ID."
          },
          "position": {
            "type": "integer",
            "format": "int32",
            "minimum": 0,
            "maximum": 2147483647
          },
          "purchasable": {
            "type": "boolean",
            "description": "Derived: available and stock null or positive; no inventory guarantee."
          },
          "images": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Image"
            },
            "minItems": 4,
            "maxItems": 4
          }
        }
      },
      "Product": {
        "type": "object",
        "required": [
          "id",
          "slug",
          "name",
          "subtitle",
          "description",
          "priceMinor",
          "currency",
          "defaultVariantId",
          "quantityPolicy",
          "variants",
          "content"
        ],
        "properties": {
          "id": {
            "type": "integer",
            "format": "int32",
            "minimum": 1,
            "maximum": 2147483647
          },
          "slug": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "subtitle": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "priceMinor": {
            "type": "integer",
            "format": "int32",
            "minimum": 0,
            "maximum": 2147483647,
            "example": 75000,
            "description": "Integer USD cents; 75000 displays USD 750.00."
          },
          "currency": {
            "type": "string",
            "enum": [
              "USD"
            ]
          },
          "defaultVariantId": {
            "type": "integer",
            "format": "int32",
            "minimum": 1,
            "maximum": 2147483647
          },
          "quantityPolicy": {
            "$ref": "#/components/schemas/QuantityPolicy"
          },
          "variants": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Variant"
            },
            "minItems": 2,
            "maxItems": 2
          },
          "content": {
            "$ref": "#/components/schemas/EditorialContent"
          }
        }
      },
      "ProductResponse": {
        "type": "object",
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "$ref": "#/components/schemas/Product"
          }
        }
      }
    }
  }
}
